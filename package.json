{
  "name": "devtools-suite",
  "version": "1.2.0",
  "description": "Dev Tools Suite - XML/JSON Formatter + WSDL→XSL Generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist-mac": "electron-builder --mac",
    "release": "electron-builder --win --x64 --publish always",
    "release-mac": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.ceyhan.devtoolssuite",
    "productName": "Dev Tools Suite",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "publish": [
      { "provider": "github", "owner": "xtceyhan", "repo": "devtools-suite-electron" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
